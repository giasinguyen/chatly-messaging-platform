@startuml Chatly_Class_System
!theme plain
top to bottom direction

skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classBorderColor #6C757D
skinparam classBackgroundColor #F8F9FA
skinparam classHeaderBackgroundColor #DEE2E6

skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageBorderThickness 2

skinparam arrowColor #495057
skinparam arrowFontSize 10
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 50

title Chatly -- Class Diagram: System Overview

' =========================================================
' FRONTEND (React)
' =========================================================
package "chatly-frontend (React)" #EEF6FF {

  package "Services" #DBEAFE {
    class FE_AuthService       <<service>>
    class FE_UserService       <<service>>
    class FE_ContactService    <<service>>
    class FE_ConversationService <<service>>
    class FE_MessageService    <<service>>
    class FE_GroupService      <<service>>
    class FE_NotificationService <<service>>
    class FE_FileService       <<service>>
    class FE_CallService       <<service>>
    class FE_SocketService     <<service>>
    class FE_AgentService      <<service>>
    class FE_AgentFileService  <<service>>
    class FE_McpService        <<service>>
    class FE_SessionService    <<service>>
  }

  package "Hooks & Context" #BFDBFE {
    class FE_CallSocketProvider <<context>>
    class FE_useChatSocket      <<hook>>
    class FE_usePresenceSocket  <<hook>>
    class FE_useNotificationSocket <<hook>>
    class FE_useCallSocket      <<hook>>
    class FE_useGroupCallSocket <<hook>>
    class FE_useWebRTC          <<hook>>
    class FE_useGroupWebRTC     <<hook>>
    class FE_useAudioRecorder   <<hook>>
    class FE_useAgentStream     <<hook>>
  }

  package "Stores" #93C5FD {
    class FE_AuthStore           <<store>>
    class FE_ChatbotStore        <<store>>
    class FE_CallStore           <<store>>
    class FE_ContactStore        <<store>>
    class FE_ConversationPrefsStore <<store>>
    class FE_NotificationStore   <<store>>
    class FE_ThemeStore          <<store>>
    class FE_UiStore             <<store>>
  }

  FE_CallSocketProvider ..> FE_useCallSocket
  FE_CallSocketProvider ..> FE_useGroupCallSocket
  FE_SocketService ..> FE_useChatSocket
  FE_SocketService ..> FE_usePresenceSocket
  FE_SocketService ..> FE_useNotificationSocket
  FE_CallService   ..> FE_useWebRTC
  FE_CallService   ..> FE_useGroupWebRTC
  FE_CallService   ..> FE_CallStore
  FE_AuthService   ..> FE_AuthStore
  FE_AgentService  ..> FE_ChatbotStore
  FE_NotificationService ..> FE_NotificationStore
  FE_ConversationService ..> FE_ConversationPrefsStore
}

