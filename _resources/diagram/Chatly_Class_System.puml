' =========================================================
' DATASTORES
' =========================================================
package "Datastores & External" #FFFDE7 {
  class PostgreSQL  <<database>>
  class MongoDB_BE  <<database>>
  class Redis       <<cache>>
  class MongoDB_AG  <<database>>
  class Qdrant      <<vector-db>>
  class MinIO_S3    <<object-storage>>
  class SMTPProvider    <<external>>
  class ExpoPushGateway <<external>>
  class GroqAPI         <<external>>
  class TavilyAPI       <<external>>
  class MCPServersExt   <<external>>
}

' =========================================================
' CROSS-MODULE DEPENDENCIES
' =========================================================

' Frontend -> Backend
FE_AuthService       ..> AuthController       : REST HTTPS
FE_MessageService    ..> MessageController    : REST HTTPS
FE_SocketService     ..> ChatMessageController : WSS STOMP /ws
FE_CallService       ..> CallWebSocketController : WSS /ws

' Mobile -> Backend
MB_AuthService       ..> AuthController       : REST HTTPS
MB_MessageService    ..> MessageController    : REST HTTPS
MB_SocketService     ..> ChatMessageController : WSS /ws-raw

' Backend -> Agent
AgentProxyClient     ..> SessionsRouter : internal HTTP\nX-Internal-API-Key
AgentProxyClient     ..> ChatRouter     : internal HTTP
AgentProxyClient     ..> FilesRouter    : internal HTTP
AgentProxyClient     ..> McpRouter      : internal HTTP

' Agent -> Backend MCP SSE
AG_MCPClient ..> AuthController : MCP SSE\n/api/ai/mcp/sse

' Backend -> Datastores
UserRepository       ..> PostgreSQL  : JDBC
ContactRepository    ..> PostgreSQL  : JDBC
ConversationRepository ..> MongoDB_BE : Mongo wire
MessageRepository    ..> MongoDB_BE  : Mongo wire
NotificationRepository ..> MongoDB_BE : Mongo wire
TokenBlacklistService ..> Redis      : RESP
FileUploadService    ..> MinIO_S3    : S3 API

' Backend -> External
ExpoPushService      ..> ExpoPushGateway : HTTPS
EmailVerificationMailService ..> SMTPProvider : SMTP

' Agent -> Datastores & External
AG_MongoClient  ..> MongoDB_AG : Mongo wire
AG_QdrantClient ..> Qdrant     : HTTP :6333
AG_MinioClient  ..> MinIO_S3   : S3 API
AG_ToolService  ..> GroqAPI    : HTTPS (LLM)
AG_ToolService  ..> TavilyAPI  : HTTPS (search)
AG_MCPClient    ..> MCPServersExt : MCP SSE

@enduml
