@startuml Chatly_UseCase_Overview
!theme plain
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8F9FA
  BorderColor #495057
  ArrowColor #495057
  FontSize 12
}
skinparam actor {
  BackgroundColor #D0E8FF
  BorderColor #1D6FA4
  FontSize 12
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #ADB5BD
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
}

title Chatly – Use Case Diagram (Full Overview)

' ─────────────────────────────────────────
' ACTORS
' ─────────────────────────────────────────
actor Guest as G
actor "Authenticated\nUser" as AU
actor "Group Owner" as GO
actor "Group Admin" as GA

actor "Email\nProvider" as EP    #LightGreen
actor "Push Notification\nGateway" as PNG  #LightGreen
actor "Object Storage\n(S3/MinIO)" as OS   #LightGreen
actor "AI Agent\nService" as AI             #LightSalmon
actor "MCP Servers" as MCP                 #LightSalmon
actor "Web Search\nProvider (Tavily)" as WS #LightSalmon

' Inheritance
GO -u-|> AU : extends
GA -u-|> AU : extends

' ─────────────────────────────────────────
' SYSTEM BOUNDARY
' ─────────────────────────────────────────
rectangle "**Chatly Messaging Platform**" {

  ' ── AUTH ──
  package "Authentication" {
    usecase "Register account" as UC_REG
    usecase "Login" as UC_LOGIN
    usecase "Verify email\nby token link" as UC_VERIFY
    usecase "Resend verification\nemail" as UC_RESEND
    usecase "Request forgot\npassword" as UC_FORGOT
    usecase "Introspect token\nvalidity" as UC_INTRO
    usecase "Logout" as UC_LOGOUT
    usecase "Refresh access\ntoken" as UC_REFRESH
    usecase "Change password" as UC_CHGPWD
    usecase "Manage login\nsessions" as UC_SESSION
  }

  ' ── PROFILE ──
  package "Profile & Settings" {
    usecase "View & update\nprofile" as UC_PROFILE
    usecase "Search users" as UC_SEARCH_USR
    usecase "Add/remove\ndevice token" as UC_DEVTOKEN
  }

  ' ── CONTACT ──
  package "Contact & Social" {
    usecase "Send friend\nrequest" as UC_FREQ
    usecase "Accept friend\nrequest" as UC_FACC
    usecase "Block / Unblock\ncontact" as UC_BLOCK
    usecase "View contacts" as UC_VIEWCON
    usecase "Delete contact" as UC_DELCON
  }

  ' ── CONVERSATION ──
  package "Conversation" {
    usecase "Create conversation\n(private or group)" as UC_CCONV
    usecase "View / List\nconversations" as UC_LCONV
    usecase "Search\nconversations" as UC_SCONV
    usecase "Delete\nconversation" as UC_DCONV
    usecase "Pin / Unpin\nconversation" as UC_PINCONV
    usecase "Mute / Unmute\nconversation" as UC_MUTECONV
  }

  ' ── MESSAGING ──
  package "Messaging" {
    usecase "Send message" as UC_SEND
    usecase "Forward message" as UC_FWD
    usecase "Load messages\n(paged)" as UC_LOADMSG
    usecase "Mark message\nas seen" as UC_SEEN
    usecase "Recall message" as UC_RECALL
    usecase "Edit message" as UC_EDIT
    usecase "Delete message" as UC_DELMSG
    usecase "React to message" as UC_REACT
    usecase "Search messages\nin conversation" as UC_SMSG
    usecase "Vote in poll" as UC_POLL
    usecase "Close poll" as UC_CLOSEPOLL
    usecase "Pin / Unpin\nmessage" as UC_PINMSG
    usecase "Tag priority" as UC_TAG
    usecase "[include] Validate\nuser membership" as UC_VMEM <<include>>
  }

  ' ── GROUP ──
  package "Group Management" {
    usecase "Add / Remove\nmember" as UC_ADDMEM
    usecase "Update member\nrole" as UC_ROLE
    usecase "Update group\ninfo" as UC_GRPINFO
    usecase "List group\nmembers" as UC_LISTMEM
    usecase "Create / Get\ninvite link" as UC_INVITE
    usecase "Join group by\ninvite link" as UC_JOIN
    usecase "List / Manage pending\njoin requests" as UC_PENDING
    usecase "Manage reminders" as UC_REMINDER
    usecase "Manage notes" as UC_NOTES
    usecase "[include] Validate\nactor permission" as UC_VPERM <<include>>
    usecase "[extend] Pending approval\n(requireApproval=true)" as UC_APPROVAL <<extend>>
  }

  ' ── NOTIFICATIONS ──
  package "Notifications" {
    usecase "List notifications" as UC_NOTIF
    usecase "Mark notification\nas read" as UC_NOTIFREAD
  }

  ' ── REALTIME & CALLS ──
  package "Realtime & Calls" {
    usecase "Send message\nvia STOMP" as UC_STOMP
    usecase "Broadcast typing\nstatus" as UC_TYPING
    usecase "Initiate / Answer\none-to-one call" as UC_CALL1
    usecase "End call" as UC_ENDCALL
    usecase "Request voice→video\nupgrade" as UC_VID
    usecase "Initiate / Join\ngroup call" as UC_GRPCALL
    usecase "Leave group call" as UC_LEAVECALL
    usecase "[extend] Video upgrade\nextends Ongoing call" as UC_VIDEXT <<extend>>
  }

  ' ── AI ──
  package "AI Assistant" {
    usecase "Manage AI sessions\n(create/list/rename/delete)" as UC_AISESS
    usecase "Send AI chat\n(blocking)" as UC_AICHAT
    usecase "Send AI chat\n(streaming)" as UC_AISTREAM
    usecase "Manage AI files\n(upload/list/delete)" as UC_AIFILE
    usecase "Manage MCP servers\n(register/list/toggle)" as UC_MCPMGR
    usecase "[include] Validate\nsession ownership" as UC_VSESS <<include>>
    usecase "[extend] Streaming extends\nBlocking AI chat" as UC_STREAMEXT <<extend>>
  }

}

' ─────────────────────────────────────────
' ASSOCIATIONS
' ─────────────────────────────────────────

' Guest
G --> UC_REG
G --> UC_LOGIN
G --> UC_VERIFY
G --> UC_RESEND
G --> UC_FORGOT
G --> UC_INTRO

' Authenticated User – Auth
AU --> UC_LOGOUT
AU --> UC_REFRESH
AU --> UC_CHGPWD
AU --> UC_SESSION

' Profile
AU --> UC_PROFILE
AU --> UC_SEARCH_USR
AU --> UC_DEVTOKEN

' Contact
AU --> UC_FREQ
AU --> UC_FACC
AU --> UC_BLOCK
AU --> UC_VIEWCON
AU --> UC_DELCON

' Conversation
AU --> UC_CCONV
AU --> UC_LCONV
AU --> UC_SCONV
AU --> UC_DCONV
AU --> UC_PINCONV
AU --> UC_MUTECONV

' Messaging
AU --> UC_SEND
AU --> UC_FWD
AU --> UC_LOADMSG
AU --> UC_SEEN
AU --> UC_RECALL
AU --> UC_EDIT
AU --> UC_DELMSG
AU --> UC_REACT
AU --> UC_SMSG
AU --> UC_POLL
AU --> UC_CLOSEPOLL
AU --> UC_PINMSG
AU --> UC_TAG

UC_SEND ..> UC_VMEM : <<include>>

' Group
AU --> UC_ADDMEM
AU --> UC_GRPINFO
AU --> UC_LISTMEM
AU --> UC_INVITE
AU --> UC_JOIN
AU --> UC_REMINDER
AU --> UC_NOTES

UC_ADDMEM ..> UC_VPERM : <<include>>
UC_JOIN ..> UC_APPROVAL : <<extend>>

' Notifications
AU --> UC_NOTIF
AU --> UC_NOTIFREAD

' Realtime
AU --> UC_STOMP
AU --> UC_TYPING
AU --> UC_CALL1
AU --> UC_ENDCALL
AU --> UC_VID
AU --> UC_GRPCALL
AU --> UC_LEAVECALL

UC_VID ..> UC_VIDEXT : <<extend>>

' AI
AU --> UC_AISESS
AU --> UC_AICHAT
AU --> UC_AISTREAM
AU --> UC_AIFILE
AU --> UC_MCPMGR

UC_AICHAT ..> UC_VSESS : <<include>>
UC_AIFILE ..> UC_VSESS : <<include>>
UC_AISTREAM ..> UC_STREAMEXT : <<extend>>

' Group Owner
GO --> UC_ROLE
GO --> UC_PENDING

' Group Admin
GA --> UC_ADDMEM
GA --> UC_REMINDER
GA --> UC_NOTES

' External actors
UC_REG ..> EP : sends email
UC_FORGOT ..> EP : sends email
UC_NOTIFREAD ..> PNG : push trigger
UC_AIFILE ..> OS : store file
UC_AICHAT ..> AI : proxy
UC_AISTREAM ..> AI : proxy
AI --> MCP : uses tools
AI --> WS : web search

@enduml


' ════════════════════════════════════════════════════════════════
' SPLIT DIAGRAMS (recommended for presentation)
' ════════════════════════════════════════════════════════════════

@startuml Chatly_UseCase_Auth
!theme plain
skinparam actorStyle awesome
skinparam usecase { BackgroundColor #EEF6FF; BorderColor #4A90D9 }
skinparam package { BackgroundColor #F5F5F5; BorderColor #BDBDBD }
title Chatly – Use Case: Authentication & Session

actor Guest as G
actor "Authenticated\nUser" as AU
actor "Email Provider" as EP #LightGreen

rectangle "Chatly – Auth Module" {
  usecase "Register account" as UC_REG
  usecase "Login" as UC_LOGIN
  usecase "Verify email" as UC_VERIFY
  usecase "Resend verification email" as UC_RESEND
  usecase "Request forgot password" as UC_FORGOT
  usecase "Introspect token validity" as UC_INTRO
  usecase "Logout" as UC_LOGOUT
  usecase "Refresh access token" as UC_REFRESH
  usecase "Change password" as UC_CHGPWD
  usecase "Manage login sessions\n(list / revoke / purge)" as UC_SESSION
}

G --> UC_REG
G --> UC_LOGIN
G --> UC_VERIFY
G --> UC_RESEND
G --> UC_FORGOT
G --> UC_INTRO

AU --> UC_LOGOUT
AU --> UC_REFRESH
AU --> UC_CHGPWD
AU --> UC_SESSION

UC_REG ..> EP : <<include>> send email
UC_FORGOT ..> EP : <<include>> send email
@enduml


