@startuml Chatly_UseCase_AI
!theme plain
skinparam actorStyle awesome
skinparam usecase { BackgroundColor #FCE4EC; BorderColor #E91E63 }
skinparam package { BackgroundColor #F5F5F5; BorderColor #BDBDBD }
title Chatly – Use Case: AI Assistant

actor "Authenticated\nUser" as AU
actor "AI Agent\nService" as AI  #LightSalmon
actor "MCP Servers" as MCP       #LightSalmon
actor "Web Search\n(Tavily)" as WS #LightSalmon
actor "Object Storage" as OS     #LightGreen

rectangle "Chatly – AI Assistant" {
  package "Session Management" {
    usecase "Create AI session" as UC_CREATE
    usecase "List AI sessions" as UC_LIST
    usecase "Get session details" as UC_DETAIL
    usecase "Rename AI session" as UC_RENAME
    usecase "Delete AI session" as UC_DELETE
    usecase "Get message history" as UC_HIST
  }
  package "Chat" {
    usecase "Send AI chat (blocking)" as UC_CHAT
    usecase "Send AI chat (streaming)" as UC_STREAM
    usecase "Validate session\nownership" as UC_VSESS <<include>>
    usecase "Streaming extends\nBlocking behavior" as UC_SEXT <<extend>>
  }
  package "File Management" {
    usecase "Upload AI session file" as UC_UPLOAD
    usecase "List AI session files" as UC_FLIST
    usecase "Delete AI session file" as UC_FDEL
    usecase "Download file content" as UC_FDWN
  }
  package "MCP Server Management" {
    usecase "Register MCP server" as UC_MREG
    usecase "List MCP servers" as UC_MLIST
    usecase "Get MCP server details" as UC_MDET
    usecase "Delete MCP server" as UC_MDEL
    usecase "Toggle MCP active flag" as UC_MTOG
    usecase "List tools for MCP server" as UC_MTOOLS
  }
}

AU --> UC_CREATE
AU --> UC_LIST
AU --> UC_DETAIL
AU --> UC_RENAME
AU --> UC_DELETE
AU --> UC_HIST
AU --> UC_CHAT
AU --> UC_STREAM
AU --> UC_UPLOAD
AU --> UC_FLIST
AU --> UC_FDEL
AU --> UC_FDWN
AU --> UC_MREG
AU --> UC_MLIST
AU --> UC_MDET
AU --> UC_MDEL
AU --> UC_MTOG
AU --> UC_MTOOLS

UC_CHAT ..> UC_VSESS : <<include>>
UC_UPLOAD ..> UC_VSESS : <<include>>
UC_STREAM ..> UC_SEXT : <<extend>>

UC_CHAT --> AI : proxy request
UC_STREAM --> AI : proxy request
AI --> MCP : invoke tools
AI --> WS : web search
UC_UPLOAD --> OS : store file
@enduml
