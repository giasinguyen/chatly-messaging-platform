@startuml Chatly_Sequence_Message_Interactions
title Chatly - Message Interactions (ECB)

autonumber
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Authenticated User" as User
boundary "Web/Mobile Client" as Client
control "MessageController\n/api/messages/*" as MessageController
control "MessageService" as MessageService
entity "Message" as MessageEntity
control "MessageRepository" as MessageRepo
control "MongoTemplate" as MongoTemplate
boundary "Topic /topic/conversation.{id}" as TopicConversation
control "GlobalExceptionHandler" as ExceptionHandler

User -> Client: Choose action (react/edit/recall)
Client -> MessageController: MessageActionRequest{messageId,\naction, content?, reaction?}
MessageController -> MessageService: applyAction(messageId, userId, action)

MessageService -> MessageRepo: findById(messageId)
MessageRepo --> MessageService: message?

alt Not found / not owner / time window expired
  MessageService -> ExceptionHandler: AppException(...)
  ExceptionHandler --> Client: HTTP 4xx\nApiResponse{error}
else Allowed
  MessageService -> MessageEntity: apply action\n(edit/react/recall)
  MessageEntity --> MessageService: updated message
  MessageService -> MongoTemplate: update message state
  MongoTemplate --> MessageService: updated
  MessageService -> TopicConversation: ChatEvent{EDIT/REACT/RECALL}
  MessageService --> MessageController: MessageResponse
  MessageController --> Client: HTTP 200\nApiResponse{code:1000, result}
end

@enduml
