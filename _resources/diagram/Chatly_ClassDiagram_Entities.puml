@startuml Chatly_ClassDiagram_Entities
!theme plain
top to bottom direction

skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classBorderColor #495057
skinparam classBackgroundColor #DBEAFE
skinparam classHeaderBackgroundColor #1D4ED8
skinparam classHeaderFontColor #FFFFFF
skinparam classHeaderFontStyle bold
skinparam classHeaderFontSize 12

skinparam class<<valueobject>> {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
  HeaderBackgroundColor #CA8A04
  HeaderFontColor #FFFFFF
}

skinparam class<<enum>> {
  BackgroundColor #F3E8FF
  BorderColor #7C3AED
  HeaderBackgroundColor #7C3AED
  HeaderFontColor #FFFFFF
}

skinparam class<<sql>> {
  BackgroundColor #DCFCE7
  BorderColor #15803D
  HeaderBackgroundColor #15803D
  HeaderFontColor #FFFFFF
}

skinparam class<<mongo>> {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
  HeaderBackgroundColor #1D4ED8
  HeaderFontColor #FFFFFF
}

skinparam class<<agent>> {
  BackgroundColor #FCE7F3
  BorderColor #BE185D
  HeaderBackgroundColor #BE185D
  HeaderFontColor #FFFFFF
