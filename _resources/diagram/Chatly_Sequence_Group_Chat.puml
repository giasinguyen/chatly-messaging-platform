@startuml Chatly_Sequence_Group_Chat
title Chatly - Group Chat (ECB)

autonumber
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Group Member" as Member
boundary "Web/Mobile Client" as Client
control "ChatMessageController\nSTOMP /app/chat.send" as ChatWsController
control "MessageService" as MessageService
entity "Conversation" as ConversationEntity
entity "Message" as MessageEntity
control "ConversationRepository" as ConversationRepo
control "MessageRepository" as MessageRepo
control "NotificationService" as NotificationService
boundary "AgentProxyClient" as AgentProxy
boundary "Topic /topic/conversation.{id}" as TopicConversation
boundary "User Queue /queue/errors" as QueueErrors

Member -> Client: Send group message
Client -> ChatWsController: chat.send{conversationId,\ncontent, mentionIds?,\nattachments?}
ChatWsController -> MessageService: send(senderId, request)

MessageService -> ConversationRepo: findById(conversationId)
ConversationRepo --> MessageService: conversation?

alt Not participant or invalid conversation
  MessageService --> ChatWsController: AppException(...)
  ChatWsController --> QueueErrors: {code, message}
  QueueErrors --> Client: Error event
else Allowed
  MessageService -> ConversationEntity: check status\n(not muted/locked)
  ConversationEntity --> MessageService: ok
  MessageService -> MessageEntity: build message
  MessageEntity --> MessageService: message
  MessageService -> MessageRepo: save(message)
  MessageRepo --> MessageService: saved
  MessageService -> NotificationService: createAndPush(NEW_MESSAGE)
  NotificationService --> MessageService: done
  MessageService -> TopicConversation: ChatEvent{SEND, messageId}
  TopicConversation --> Client: Broadcast to members

  opt Mention or @AI feature
    MessageService -> NotificationService: create mention notification
    MessageService -> AgentProxy: triggerAssistAsync(...)
  end
end

@enduml
