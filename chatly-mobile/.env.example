EXPO_PUBLIC_API_BASE_URL=http://192.168.xx.xx:8080
EXPO_PUBLIC_WS_URL=ws://192.168.xx.xx:8080/ws-raw
EXPO_PUBLIC_KLIPY_API_KEY=

# Nếu lỗi kết nôi EXPO GO thì chạy Mở PowerShell As Administrator và chạy: 
FIX=New-NetFirewallRule -DisplayName "Chatly Backend 8080" -Direction Inbound -Protocol TCP -LocalPort 8080 -Action Allow -Profile Any

# Optional WebRTC ICE override for calls across different networks.
# Comma-separated URLs. Use a private TURN service in production.
EXPO_PUBLIC_WEBRTC_STUN_URLS=
EXPO_PUBLIC_WEBRTC_TURN_URLS=
EXPO_PUBLIC_WEBRTC_TURN_USERNAME=
EXPO_PUBLIC_WEBRTC_TURN_CREDENTIAL=
EXPO_PUBLIC_WEBRTC_FORCE_RELAY=false