GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

MONGODB_URI=mongodb://localhost:27018
MONGODB_DB_NAME=agent_server

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agent_server_chunks
QDRANT_VECTOR_SIZE=768

HUGGINGFACE_API_KEY=hf_...
HF_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ─── Object Storage ───────────────────────────────────────────
# Choose "minio" (local dev) or "s3" (AWS production).
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=uploads

# --- AWS S3 (used when STORAGE_PROVIDER=s3) ---
# STORAGE_ACCESS_KEY=your_aws_access_key
# STORAGE_SECRET_KEY=your_aws_secret_key
# STORAGE_BUCKET=your-production-bucket
# STORAGE_REGION=ap-southeast-1

INTERNAL_API_KEY=change-me-use-a-long-random-string-min-32-chars

TAVILY_API_KEY=tvly-dev-...

# ─── Chatly Backend MCP (system default) ──────────────────────────────────────
# URL of the chatly-backend MCP endpoint exposed by chatly-backend.
# Leave empty to disable built-in backend tools.
CHATLY_BACKEND_MCP_URL=http://chatly-backend:8080/api/ai/mcp/sse

# ─── LangSmith (optional) ─────────────────────────────────────────────────────
# Set LANGSMITH_TRACING=true only when you provide LANGSMITH_API_KEY.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="chatly-agent"

APP_ENV=development
