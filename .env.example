# =============================================================================
# Chatly Messaging Platform — Production Environment Variables
# =============================================================================
# Copy this file to .env in the project root, then fill in every value.
#
#   cp .env.example .env
#
# NEVER commit the actual .env file to version control.
# Variables set in the [environment:] section of docker-compose.yml
# (service URLs, DB hostnames) are already wired — do NOT override them here.
# =============================================================================

# ─── Docker Hub ──────────────────────────────────────────────────────────────
# Your Docker Hub username. Used to pull images built by CI/CD.
# docker-compose.yml references: ${DOCKERHUB_USERNAME}/chatly-backend:latest
#                                ${DOCKERHUB_USERNAME}/chatly-agent:latest
DOCKERHUB_USERNAME=your-dockerhub-username


# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Credentials used by the postgres container and forwarded to the backend.
POSTGRES_DB=chatly
POSTGRES_USER=chatly
POSTGRES_PASSWORD=change-me-strong-postgres-password


# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password


# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Database name used by the AI Agent (backend DB name is fixed to "chatly").
MONGODB_DB_NAME=agent_server


# ─── Internal API Key ─────────────────────────────────────────────────────────
# Shared secret between Backend and AI Agent for internal calls.
# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
INTERNAL_API_KEY=change-me-use-a-long-random-string-min-32-chars


# ─── JWT (Backend) ────────────────────────────────────────────────────────────
# Base64-encoded secret for signing JWTs. Generate with:
#   openssl rand -base64 48
APP_JWT_SECRET=change-me-use-a-long-random-base64-encoded-string
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000


# ─── CORS & Public URLs (Backend) ─────────────────────────────────────────────
# Add all origins that the frontend will use (comma-separated, no trailing slash).
# Include your EC2 public IP and/or domain.
APP_CORS_ALLOWED_ORIGINS=http://your-ec2-public-ip,https://your-domain.com

# URL used in email verification links sent to users. Replace with public URL.
APP_AUTH_VERIFICATION_LINK_BASE_URL=http://your-ec2-public-ip:8080/api/auth/verify-email

APP_AUTH_VERIFICATION_EXPIRATION_MINUTES=15
APP_AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=60


# ─── JPA DDL (Backend) ────────────────────────────────────────────────────────
# First deploy: set to "update" so Hibernate creates tables automatically.
# After tables are created, change to "validate" for safety.
JPA_DDL_AUTO=update


# ─── Mail (Backend) ───────────────────────────────────────────────────────────
# Use a Gmail App Password (not your regular Gmail password).
# Create at: https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password
APP_MAIL_FROM=your-email@gmail.com


# ─── AWS S3 Storage ───────────────────────────────────────────────────────────
# Used by both Backend (profile pictures, reels) and AI Agent (file uploads).
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-s3-bucket-name

# AI Agent reads these names (separate from Backend AWS vars above):
STORAGE_ACCESS_KEY=your-aws-access-key-id
STORAGE_SECRET_KEY=your-aws-secret-access-key
STORAGE_BUCKET=your-s3-bucket-name
STORAGE_REGION=ap-southeast-1


# ─── Music API (Backend — optional) ──────────────────────────────────────────
JAMENDO_CLIENT_ID=your-jamendo-client-id
JAMENDO_CLIENT_SECRET=your-jamendo-client-secret
JAMENDO_BASE_URL=https://api.jamendo.com/v3.0


# ─── Agent Timeout (Backend) ─────────────────────────────────────────────────
AGENT_TIMEOUT_SECONDS=60
AGENT_STREAM_TIMEOUT_SECONDS=120


# ─── Social AI (Backend) ──────────────────────────────────────────────────────
SOCIAL_AI_ENABLED=true
SOCIAL_AI_BOT_USER_ID=00000000-0000-0000-0000-000000000001
SOCIAL_AI_MENTION_RATE_LIMIT_PER_HOUR=10


# ─── File / Reel Size Limits (Backend) ────────────────────────────────────────
REEL_MAX_VIDEO_SIZE_MB=20
REEL_MULTIPART_MAX_FILE_SIZE=20MB
REEL_MULTIPART_MAX_REQUEST_SIZE=25MB


# ─── AI Agent — LLM ──────────────────────────────────────────────────────────
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile


# ─── AI Agent — Embeddings ────────────────────────────────────────────────────
# HuggingFace token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your-huggingface-api-key
HF_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5


# ─── AI Agent — Vector DB ─────────────────────────────────────────────────────
QDRANT_COLLECTION_NAME=agent_server_chunks
QDRANT_VECTOR_SIZE=768
# Leave empty if Qdrant runs without authentication (default for local Docker).
QDRANT_API_KEY=


# ─── AI Agent — Web Search (optional) ────────────────────────────────────────
# Tavily API key: https://app.tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key


# ─── AI Agent — MinIO bucket name (used when STORAGE_PROVIDER=minio) ─────────
MINIO_BUCKET_NAME=uploads


# ─── Spring Boot MCP Server (Backend) ────────────────────────────────────────
# These have safe defaults; override only if needed.
# SPRING_AI_MCP_ENABLED=true
# SPRING_AI_MCP_SERVER_NAME=chatly-backend-mcp
# SPRING_AI_MCP_SERVER_VERSION=0.0.1
# SPRING_AI_MCP_SSE_ENDPOINT=/api/ai/mcp/sse
# SPRING_AI_MCP_SSE_MESSAGE_ENDPOINT=/api/ai/mcp/message
