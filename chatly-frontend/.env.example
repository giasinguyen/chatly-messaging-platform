# Copy this file & create .env

# http://localhost:8080
VITE_BACKEND_BASE_URL=
# Public base URL of this web app (used for invite links). Leave blank to auto-detect from browser origin.
VITE_WEB_BASE_URL=
VITE_KLIPY_API_KEY=

# Optional WebRTC ICE override for calls across different networks.
# Comma-separated URLs. Use a private TURN service in production.
VITE_WEBRTC_STUN_URLS=
VITE_WEBRTC_TURN_URLS=
VITE_WEBRTC_TURN_USERNAME=
VITE_WEBRTC_TURN_CREDENTIAL=
VITE_WEBRTC_FORCE_RELAY=false
