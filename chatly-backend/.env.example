# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/chatly
DATABASE_USERNAME=chatly
DATABASE_PASSWORD=your_database_password

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/chatly

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
SERVER_PORT=8080

# JPA Configuration
JPA_DDL_AUTO=validate

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Storage Configuration
# Use "local" for local file system (development) or "s3" for AWS S3 (production)
STORAGE_PROVIDER=s3

# AWS S3 Configuration (required when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY=your_access_key_id
AWS_SECRET_KEY=your_secret_access_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your_bucket_name

# AI Agent Configuration (must match INTERNAL_API_KEY in chatly-agent)
AGENT_BASE_URL=http://localhost:8000
AGENT_API_KEY=change-me-use-a-long-random-string-min-32-chars
AGENT_TIMEOUT_SECONDS=60
AGENT_STREAM_TIMEOUT_SECONDS=120

# Music API
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=
JAMENDO_BASE_URL=https://api.jamendo.com/v3.0

# Agora RTC
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_TOKEN_TTL_SECONDS=3600

APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000, http://localhost:5174, http://54.254.204.51, http://54.254.204.51:3000, https://lw57f7ms-3000.asse.devtunnels.ms
APP_AUTH_VERIFICATION_EXPIRATION_MINUTES=15
APP_AUTH_VERIFICATION_RESEND_COOLDO=SECONDS=60
APP_AUTH_VERIFICATION_LINK_BASE_URL=http://localhost:8080/api/auth/verify-email
