                  "        pm.collectionVariables.set('refreshToken', jsonData.result.refreshToken);",
                  "        if (jsonData.result.user && jsonData.result.user.id) {",
                  "            pm.collectionVariables.set('userId', jsonData.result.user.id);",
                  "        }",
