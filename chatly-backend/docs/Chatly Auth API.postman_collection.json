{
	"info": {
		"_postman_id": "283a67cd-ab72-4e60-886c-13229e779f8d",
		"name": "Chatly Auth API",
		"description": "Authentication API endpoints for Chatly messaging platform with JWT token support",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "27625274"
	},
	"item": [
		{
			"name": "Register",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.result && jsonData.result.token) {",
							"        pm.collectionVariables.set('accessToken', jsonData.result.token);",
							"        pm.collectionVariables.set('refreshToken', jsonData.result.refreshToken);",
							"        console.log('Tokens saved to collection variables');",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"displayName\": \"John Doe\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"register"
					]
				},
				"description": "Register a new user account. Returns access token, refresh token, and user information."
			},
			"response": []
		},
